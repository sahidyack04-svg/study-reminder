# Local dev: SQLite file (Prisma's sqlite connector, no server needed).
# Production: a Postgres connection string, e.g. "postgres://user:password@host:5432/dbname" — see
# docs/superpowers/specs/2026-10-14-phase1-foundation-design.md ("SQLite <-> Postgres portability") for the cutover.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Study Reminder <onboarding@resend.dev>"
