# A Postgres connection string, local or managed. Local dev example assumes
# a local Postgres service with a "study_reminder_dev" database already
# created (`createdb study_reminder_dev` or `psql -c "CREATE DATABASE ..."`).
# Production uses a separate managed Postgres (Neon) DATABASE_URL set
# directly in Vercel's environment variables, never in this file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/study_reminder_dev"
AUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Study Reminder <onboarding@resend.dev>"
